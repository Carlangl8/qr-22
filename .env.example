# Configuración de variables de entorno (Supabase)
# Copia este archivo como .env y rellena tus claves de tu Dashboard de Supabase.

# URLs de Supabase (Ambas suelen ser la misma)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxx.supabase.co"
SUPABASE_URL="https://xxxxxx.supabase.co"

# Claves de Supabase
# Esta clave es pública y segura para ser usada en el cliente web
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI...TU_CLAVE_ANONIMA_AQUI"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI...TU_CLAVE_ANONIMA_AQUI"

# IMPORTANTE: Clave de Rol de Servicio (Service Role Key)
# Esta clave tiene permisos absolutos. NUNCA debe estar expuesta en el lado del cliente (public/).
# Solo se utilizará en las rutas del servidor (carpeta api/ o servidor node).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI...TU_SERVICE_ROLE_KEY_AQUI"
